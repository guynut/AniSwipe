{
  "name": "aniswipe-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && bun --watch src/index.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "prisma generate && bun run dist/index.js",
    "test": "bun test",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "elysia": "^1.1.17"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "typescript": "^5.6.2"
  }
}

{
  "name": "aniswipe",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "bun run dev:frontend & bun run dev:backend && wait",
    "dev:frontend": "bun run --cwd apps/frontend dev",
    "dev:backend": "bun run --cwd apps/backend dev",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "typecheck": "bun run typecheck:frontend && bun run typecheck:backend",
    "typecheck:frontend": "bun run --cwd apps/frontend typecheck",
    "typecheck:backend": "bun run --cwd apps/backend typecheck",
    "build": "bun run build:frontend && bun run build:backend",
    "build:frontend": "bun run --cwd apps/frontend build",
    "build:backend": "bun run --cwd apps/backend build",
    "test": "bun run test:frontend && bun run test:backend",
    "test:frontend": "bun run --cwd apps/frontend test",
    "test:backend": "bun run --cwd apps/backend test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0"
  }
}
